{
  "name": "codependence",
  "version": "1.0.8",
  "description": "Enforce dependency version policy across projects, workspaces, and CI.",
  "homepage": "https://jeffry.in/codependence",
  "bugs": {
    "url": "https://github.com/yowainwright/codependence/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yowainwright/codependence.git"
  },
  "author": "Jeff Wainwright <yowainwright@gmail.com> (https://jeffry.in)",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "devDependencies": {
    "bun-types": "1.3.14",
    "eslint-plugin-legibility": "^0.2.0",
    "fast-check": "^4.9.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "pastoralist": "^1.12.8",
    "prettier": "^3.9.4",
    "release-it": "20.2.1",
    "scriptc": "0.0.21",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "effect": "^3.22.1",
    "yaml": "^2.9.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "codependence": "dist/cli.js",
    "cdp": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "scripts/install-legibility-skill.js"
  ],
  "keywords": [
    "peerDependencies",
    "optionalDependencies",
    "optional-dependencies",
    "dependencies",
    "devDependencies",
    "dependency-policy",
    "version-policy",
    "versioning",
    "versions",
    "monorepo",
    "ci",
    "semver"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nub run build-dist",
    "build:bin": "nub scripts/build-bin.ts",
    "build-dist": "bun build src/index.ts --format esm --outfile dist/index.js --target node && bun build src/index.ts --format cjs --outfile dist/index.cjs --target node && bun build src/cli.ts --format esm --outfile dist/cli.js --target node && chmod +x dist/cli.js && bunx tsc --emitDeclarationOnly --declaration --outDir dist --rootDir src",
    "clean-dist": "rm -rf dist",
    "clean": "nub run clean-dist && cd page/app && rm -rf dist",
    "cmd:node:test-fail-run": "node dist/cli.js --config './tests/unit/fixtures/test-fail-package.json' --files 'test-fail-package.json' --rootDir './tests/unit/fixtures/' --debug",
    "cmd:node:test-pass-run": "node dist/cli.js --config './tests/unit/fixtures/test-pass-package.json' --files 'test-pass-package.json'  --rootDir './tests/unit/fixtures/' --debug",
    "cmd:bun:test-search": "bun src/cli.ts --rootDir './tests/unit/fixtures/' --debug --searchPath './tests/unit/fixtures/.codependencerc' --isTestingCLI",
    "cmd:bun:test-fail-run": "bun src/cli.ts --config './tests/unit/fixtures/test-fail-package.json' --files 'test-fail-package.json' --rootDir './tests/unit/fixtures/' --debug",
    "cmd:bun:test-pass-run": "bun src/cli.ts --config './tests/unit/fixtures/test-pass-package.json' --files 'test-pass-package.json'  --rootDir './tests/unit/fixtures/' --debug",
    "cmd:bun:test-update-run": "bun src/cli.ts --config './tests/unit/fixtures/test-fail-package.json' --files 'test-fail-package.json' --rootDir './tests/unit/fixtures/' --debug --isTesting",
    "cmd:bun:test-codependencies-cli": "bun src/cli.ts -c './tests/unit/fixtures/test-fail-package.json' --files 'test-fail-package.json' -cds 'lodash' '{ \"fs-extra\": \"10.0.1\" }' --rootDir './tests/unit/fixtures/' --debug --isTesting",
    "coverage": "bun test --coverage",
    "dev": "nub run docs:dev",
    "docs:dev": "cd page/app && nub run dev",
    "docs:build": "cd page/app && nub run build",
    "docs:preview": "cd page/app && nub run preview",
    "deps:audit": "nub audit",
    "deps:overrides": "pastoralist --remove-unused --summary",
    "deps:security": "pastoralist --checkSecurity --summary --strict",
    "format-src": "oxfmt --write src",
    "format-test": "oxfmt --write tests",
    "format-app": "prettier --write page/app",
    "format": "nub run format-src && nub run format-test && nub run format-app",
    "lint": "nub run lint-src",
    "lint-fix": "oxlint . --fix",
    "lint-src": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "hooks:setup": "sh scripts/setup-hooks.sh",
    "prepare": "nub run hooks:setup",
    "prepublishOnly": "nub run clean-dist && nub run build-dist",
    "preview": "nub run docs:preview",
    "release": "nub scripts/release.ts",
    "release:patch": "nub scripts/release.ts --increment=patch",
    "release:patch:dry": "nub scripts/release.ts --increment=patch --dry-run",
    "release:minor": "nub scripts/release.ts --increment=minor",
    "release:minor:dry": "nub scripts/release.ts --increment=minor --dry-run",
    "release:major": "nub scripts/release.ts --increment=major",
    "release:major:dry": "nub scripts/release.ts --increment=major --dry-run",
    "release:alpha": "nub scripts/release.ts --preRelease=alpha",
    "release:alpha:dry": "nub scripts/release.ts --preRelease=alpha --dry-run",
    "release:beta": "nub scripts/release.ts --preRelease=beta",
    "release:beta:dry": "nub scripts/release.ts --preRelease=beta --dry-run",
    "release:rc": "nub scripts/release.ts --preRelease=rc",
    "release:rc:dry": "nub scripts/release.ts --preRelease=rc --dry-run",
    "release:tag": "nub scripts/tag-release.ts",
    "release:tag:dry": "nub scripts/tag-release.ts --dry-run",
    "release:dry": "nub scripts/release.ts --dry-run",
    "setup": "nub install && nub run hooks:setup && nub run build",
    "test": "nub run test-src",
    "test:e2e:binary": "./tests/e2e/test-binary.sh",
    "test-src": "bun test",
    "typecheck": "nub run typecheck-src",
    "typecheck-src": "tsc --noEmit",
    "update": "nub update",
    "validate": "nub run typecheck && nub run lint && nub run test",
    "validate:full": "nub run validate && ./tests/e2e/test-multilang.sh all",
    "skills:install": "node scripts/install-legibility-skill.js agents",
    "skills:install:claude": "node scripts/install-legibility-skill.js claude",
    "skills:install:claude:local": "node scripts/install-legibility-skill.js claude --local",
    "skills:install:codex": "node scripts/install-legibility-skill.js codex",
    "skills:install:codex:local": "node scripts/install-legibility-skill.js codex --local",
    "skills:install:local": "node scripts/install-legibility-skill.js agents --local"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "warn"
    }
  },
  "pastoralist": {
    "appendix": {
      "undici@7.28.0": {
        "dependents": {
          "codependence": "undici (required by release-it)"
        },
        "ledger": {
          "addedDate": "2026-06-28T00:00:00.000Z"
        }
      },
      "vite@8.1.3": {
        "dependents": {
          "codependence": "vite (unused override)",
          "@codependence/docs": "vite@^8.1.0"
        },
        "ledger": {
          "addedDate": "2026-07-02T00:00:00.000Z"
        }
      },
      "postcss@8.5.18": {
        "dependents": {
          "codependence": "postcss (required by vite)",
          "@codependence/docs": "postcss (required by vite)"
        },
        "ledger": {
          "addedDate": "2026-08-02T00:00:00.000Z",
          "reason": "Security fix for GHSA-r28c-9q8g-f849 (high)",
          "securityChecked": true,
          "securityCheckDate": "2026-08-02T00:00:00.000Z",
          "securityProvider": "npm",
          "securityCheckResult": "clean",
          "vulnerableRange": "<=8.5.17",
          "patchedVersion": "8.5.18"
        }
      },
      "ip-address@10.3.1": {
        "dependents": {
          "codependence": "ip-address (required by socks)"
        },
        "ledger": {
          "addedDate": "2022-06-13T19:05:47-07:00"
        }
      },
      "postcss@8.5.23": {
        "dependents": {
          "codependence": "postcss (required by vite)",
          "@codependence/docs": "postcss (required by vite)"
        },
        "ledger": {
          "addedDate": "2022-06-13T19:05:47-07:00"
        }
      },
      "undici@7.29.0": {
        "dependents": {
          "codependence": "undici (required by release-it)"
        },
        "ledger": {
          "addedDate": "2022-06-13T19:05:47-07:00"
        }
      },
      "nanoid@3.3.17": {
        "dependents": {
          "codependence": "nanoid (required by postcss)"
        },
        "ledger": {
          "addedDate": "2022-06-13T19:05:47-07:00"
        }
      }
    },
    "depPaths": "workspace",
    "security": {
      "provider": "osv",
      "severityThreshold": "medium",
      "hasWorkspaceSecurityChecks": true
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): ${version}",
      "commitArgs": [
        "--no-verify"
      ],
      "tagName": "v${version}"
    },
    "npm": {
      "publish": false
    }
  }
}
