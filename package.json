    },
    "security": {
      "enabled": true,
      "provider": "osv",
      "severityThreshold": "medium",
      "hasWorkspaceSecurityChecks": true,
      "strict": true
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): ${version}",
      "commitArgs": [
        "--no-verify"
      ],
      "tagName": "v${version}"
    },
    "npm": {
      "publish": false
    }
  }
}
