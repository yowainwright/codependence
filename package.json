          "cveDetails": [
            {
              "cve": "CVE-2026-111997",
              "severity": "medium",
              "patchedVersion": "10.7.4"
            }
          ],
          "severity": "medium",
          "url": "https://github.com/beaugunderson/ip-address/security/advisories/GHSA-rxp7-6hxx-x8q5",
          "vulnerableRange": ">= 0 < 10.7.4",
