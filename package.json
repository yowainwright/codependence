{
  "name": "codependence",
  "version": "1.0.15",
  "description": "Enforce dependency version policy across projects, workspaces, and CI.",
  "keywords": [
    "ci",
    "dependencies",
    "dependency-policy",
    "devDependencies",
    "monorepo",
    "optional-dependencies",
    "optionalDependencies",
    "peerDependencies",
    "semver",
    "version-policy",
    "versioning",
    "versions"
  ],
  "homepage": "https://jeffry.in/codependence",
  "bugs": {
    "url": "https://github.com/yowainwright/codependence/issues"
  },
  "license": "MIT",
  "author": "Jeff Wainwright <yowainwright@gmail.com> (https://jeffry.in)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yowainwright/codependence.git"
  },
  "bin": {
    "cdp": "dist/cli.js",
    "codependence": "dist/cli.js"
  },
  "workspaces": [
    "page/app"
  ],
  "files": [
    "dist/cli.js",
    "dist/index.js",
    "dist/index.cjs",
    "src/types.ts",
    "src/constants.ts",
    "src/providers/constants.ts",
    "src/config/schema.json"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "src/types.ts",
  "exports": {
    ".": {
      "types": "./src/types.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema.json": "./src/config/schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nub scripts/build/index.ts dist",
    "build:bin": "nub scripts/build/index.ts bin",
    "build-dist": "nub scripts/build/index.ts dist",
    "clean-dist": "rm -rf dist",
    "clean": "rm -rf dist && cd page/app && rm -rf dist",
    "cmd:node:test-fail-run": "node dist/cli.js --config './tests/unit/fixtures/test-fail-package.json' --files 'test-fail-package.json' --rootDir './tests/unit/fixtures/' --debug",
    "cmd:node:test-pass-run": "node dist/cli.js --config './tests/unit/fixtures/test-pass-package.json' --files 'test-pass-package.json'  --rootDir './tests/unit/fixtures/' --debug",
    "coverage": "nub scripts/run/index.ts --coverage",
    "dev": "cd page/app && nub run dev",
    "docs:dev": "cd page/app && nub run dev",
    "docs:build": "cd page/app && nub run build",
    "docs:preview": "cd page/app && nub run preview",
    "deps:audit": "nub audit",
    "deps:overrides": "pastoralist --remove-unused --summary -d page/app/package.json",
    "deps:security": "pastoralist --dry-run --checkSecurity --summary -d page/app/package.json",
    "fmt:check": "oxfmt --check",
    "format-src": "oxfmt --write src",
    "format-test": "oxfmt --write tests",
    "format-app": "prettier --write page/app",
    "format": "oxfmt --write src && oxfmt --write tests && prettier --write page/app",
    "lint": "nub run lint:strict",
    "lint:agent": "NODE_OPTIONS= node --preserve-symlinks-main node_modules/eslint-plugin-legibility/bin/lint-changed.js --comments=forbid && nub run lint:shell",
    "lint:all": "nub run lint:strict",
    "lint:agent:all": "NODE_OPTIONS= oxlint . --deny-warnings --deny legibility/no-unmatched-comments && nub run lint:shell",
    "lint-fix": "NODE_OPTIONS= oxlint . --fix",
    "lint-src": "nub run lint:changed",
    "lint:strict": "nub run lint:js && nub run lint:shell",
    "lint:fix": "NODE_OPTIONS= oxlint src --fix",
    "hooks:setup": "sh scripts/setup.sh",
    "prepublishOnly": "rm -rf dist && nub scripts/build/index.ts dist",
    "preview:styleguide": "nub src/cli/index.ts --styleguide",
    "preview": "cd page/app && nub run preview",
    "release": "nub scripts/release/index.ts",
    "release:patch": "nub scripts/release/index.ts --increment=patch",
    "release:patch:dry": "nub scripts/release/index.ts --increment=patch --dry-run",
    "release:minor": "nub scripts/release/index.ts --increment=minor",
    "release:minor:dry": "nub scripts/release/index.ts --increment=minor --dry-run",
    "release:major": "nub scripts/release/index.ts --increment=major",
    "release:major:dry": "nub scripts/release/index.ts --increment=major --dry-run",
    "release:alpha": "nub scripts/release/index.ts --preRelease=alpha",
    "release:alpha:dry": "nub scripts/release/index.ts --preRelease=alpha --dry-run",
    "release:beta": "nub scripts/release/index.ts --preRelease=beta",
    "release:beta:dry": "nub scripts/release/index.ts --preRelease=beta --dry-run",
    "release:rc": "nub scripts/release/index.ts --preRelease=rc",
    "release:rc:dry": "nub scripts/release/index.ts --preRelease=rc --dry-run",
    "release:tag": "nub scripts/release/index.ts tag",
    "release:tag:dry": "nub scripts/release/index.ts tag --dry-run",
    "release:dry": "nub scripts/release/index.ts --dry-run",
    "setup": "nub install && sh scripts/setup.sh && nub scripts/build/index.ts dist",
    "test": "nub scripts/run/index.ts",
    "test:e2e:binary": "./tests/e2e/test-binary.sh",
    "update": "nub update",
    "validate": "nub run lint:strict && nub scripts/run/index.ts",
    "validate:full": "nub run validate && ./tests/e2e/test-multilang.sh all",
    "skills:install": "node scripts/install/index.js agents",
    "skills:install:claude": "node scripts/install/index.js claude",
    "skills:install:claude:local": "node scripts/install/index.js claude --local",
    "skills:install:codex": "node scripts/install/index.js codex",
    "skills:install:codex:local": "node scripts/install/index.js codex --local",
    "skills:install:local": "node scripts/install/index.js agents --local",
    "precoverage": "mkdir -p coverage",
    "lint:changed": "NODE_OPTIONS= node --preserve-symlinks-main node_modules/eslint-plugin-legibility/bin/lint-changed.js",
    "lint:js": "NODE_OPTIONS= oxlint . --deny-warnings",
    "lint:shell": "mise exec -- shellcheck-legibility check scripts --config scripts/.shellcheck-legibility.toml && mise exec -- shellcheck-legibility check tests --config scripts/.shellcheck-legibility.toml --ignore LEG025"
  },
  "devDependencies": {
    "@nubjs/nub": "0.9.2",
    "@types/node": "26.6.2",
    "eslint-plugin-legibility": "^0.4.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "pastoralist": "1.13.4",
    "prettier": "^3.9.8",
    "release-it": "21.1.0",
    "rolldown": "1.2.9",
    "scriptc": "0.1.3",
    "turbo": "2.11.2"
  },
  "overrides": {
    "ip-address": "10.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "undici": "7.29.0",
    "vite": "8.2.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "pastoralist": {
    "appendix": {
      "undici@7.28.0": {
        "dependents": {
          "codependence": "undici (required by release-it)"
        },
        "ledger": {
          "addedDate": "2026-06-28T00:00:00.000Z"
        }
      },
      "vite@8.2.1": {
        "dependents": {
          "codependence": "vite (unused override)",
          "@codependence/docs": "vite@^8.2.1"
        },
        "ledger": {
          "addedDate": "2026-07-02T00:00:00.000Z"
        }
      },
      "postcss@8.5.18": {
        "dependents": {
          "codependence": "postcss (required by vite)",
          "@codependence/docs": "postcss (required by vite)"
        },
        "ledger": {
          "addedDate": "2026-08-02T00:00:00.000Z",
          "reason": "Security fix for GHSA-r28c-9q8g-f849 (high)",
          "securityChecked": true,
          "securityCheckDate": "2026-08-02T00:00:00.000Z",
          "securityProvider": "npm",
          "securityCheckResult": "clean",
          "vulnerableRange": "<=8.5.17",
          "patchedVersion": "8.5.18"
        }
      },
      "ip-address@10.3.1": {
        "dependents": {
          "codependence": "ip-address (required by socks)"
        },
        "ledger": {
          "addedDate": "2022-06-13T19:05:47-07:00"
        }
      },
      "postcss@8.5.23": {
        "dependents": {
          "codependence": "postcss (unused override)",
          "@codependence/docs": "postcss (required by vite)"
        },
        "ledger": {
          "addedDate": "2022-06-13T19:05:47-07:00"
        }
      },
      "undici@7.29.0": {
        "dependents": {
          "codependence": "undici (required by release-it)"
        },
        "ledger": {
          "addedDate": "2022-06-13T19:05:47-07:00"
        }
      },
      "nanoid@3.3.18": {
        "dependents": {
          "codependence": "nanoid (required by postcss)"
        },
        "ledger": {
          "addedDate": "2022-06-13T19:05:47-07:00",
          "reason": "Security fix for GHSA-2v37-7h3g-55p8 (high)",
          "securityChecked": true,
          "securityCheckDate": "2026-08-13T00:00:00.000Z",
          "securityProvider": "npm",
          "securityCheckResult": "clean",
          "vulnerableRange": "<3.3.18",
          "patchedVersion": "3.3.18"
        }
      }
    },
    "security": {
      "enabled": true,
      "provider": "osv",
      "severityThreshold": "medium",
      "hasWorkspaceSecurityChecks": true,
      "strict": true
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): ${version}",
      "commitArgs": [
        "--no-verify"
      ],
      "tagName": "v${version}"
    },
    "npm": {
      "publish": false
    }
  }
}
