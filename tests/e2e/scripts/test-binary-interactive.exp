#!/usr/bin/expect -f

set timeout 10
set binary [lindex $argv 0]
set work_dir [lindex $argv 1]

cd $work_dir
spawn -noecho $binary init

expect {
  -re {Enter your choice \(number\):} { send -- "2\r" }
  timeout { exit 1 }
  eof { exit 1 }
}

expect {
  -re {Enter your choice \(number\):} { send -- "1\r" }
  timeout { exit 1 }
  eof { exit 1 }
}

expect {
  -re {setup complete!} {}
  timeout { exit 1 }
  eof { exit 1 }
}

expect eof
set result [wait]
exit [lindex $result 3]
