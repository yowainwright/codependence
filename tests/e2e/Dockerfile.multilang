# Multi-language Dockerfile for testing provider support
ARG NODE_SLIM_IMAGE=node:26-slim@sha256:4ebb5ace66f15a24c14c492e01a8beeed4fddf970a856109f5126e703e5fe503
FROM ${NODE_SLIM_IMAGE} AS builder

# Install build tools
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package.json ./
COPY pnpm-lock.yaml ./
COPY pnpm-workspace.yaml ./
COPY page/ ./page/

# Install Node.js dependencies
RUN npm install --global @nubjs/nub@0.7.5
RUN nub install --frozen-lockfile --ignore-scripts

# Copy source code and build
COPY . .
RUN nub run build-dist

# Multi-language test stage with Python and Go
FROM ${NODE_SLIM_IMAGE} AS multilang-test

# Install system dependencies for Python, Go, and other tools
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Install Go
ARG GO_VERSION=1.21.5
ARG TARGETARCH
RUN set -eu; \
    go_arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$go_arch" in \
        amd64|arm64) ;; \
        *) echo "Unsupported Go architecture: $go_arch" >&2; exit 1 ;; \
    esac; \
    wget -q "https://go.dev/dl/go${GO_VERSION}.linux-${go_arch}.tar.gz"; \
    tar -C /usr/local -xzf "go${GO_VERSION}.linux-${go_arch}.tar.gz"; \
    rm "go${GO_VERSION}.linux-${go_arch}.tar.gz"

ENV PATH="/usr/local/go/bin:$PATH"
ENV GOPATH="/go"
ENV PATH="$GOPATH/bin:$PATH"

RUN npm install --global @nubjs/nub@0.7.5

# Create test user
RUN groupadd -g 1001 testuser && \
    useradd -r -u 1001 -g testuser -m testuser && \
    mkdir -p /go && \
    chown -R testuser:testuser /go

WORKDIR /test

# Copy built distribution from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder /app/page ./page
RUN mkdir -p scripts
COPY --from=builder /app/scripts/install-legibility-skill.js ./scripts/install-legibility-skill.js

# Install production dependencies when they exist
RUN if node -e "const pkg = require('./package.json'); process.exit(Object.keys(pkg.dependencies || {}).length === 0 ? 0 : 1)"; then \
        echo "No production dependencies to install"; \
    else \
        nub install --prod --frozen-lockfile --ignore-scripts; \
    fi
RUN mkdir -p node_modules/.bin
COPY --from=builder /app/node_modules/eslint-plugin-legibility ./node_modules/eslint-plugin-legibility
COPY --from=builder /app/node_modules/.bin/eslint-plugin-legibility-install-skill ./node_modules/.bin/eslint-plugin-legibility-install-skill

# Copy all test fixtures
COPY tests/e2e/fixtures/ ./
COPY tests/fixtures/ ./tests/fixtures/

# Copy e2e test scripts
COPY tests/e2e/test-go-update.sh ./
COPY tests/e2e/test-agent-skill-install.sh ./
COPY tests/e2e/test-packed-install.sh ./
COPY tests/e2e/provider/ ./provider/

# Make all test scripts executable
RUN chmod +x *.sh provider/*.sh

# Change ownership
RUN chown -R testuser:testuser /test

# Switch to test user
USER testuser

# Set default command to run Python/Go tests
CMD ["./test-python-go.sh"]
