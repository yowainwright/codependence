{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#build-dist": {
      "outputs": ["dist/**"]
    },
    "//#build-bin": {
      "cache": false,
      "outputs": ["artifacts/codependence"]
    },
    "//#lint:js": {},
    "//#lint:shell": {
      "cache": false
    },
    "//#test-src": {
      "dependsOn": ["//#build-dist"],
      "env": ["CI", "GITHUB_ACTIONS"]
    },
    "//#coverage-src": {
      "dependsOn": ["//#build-dist"],
      "env": ["CI", "GITHUB_ACTIONS"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/src/**"]
    },
    "test:smoke": {
      "dependsOn": ["build"],
      "env": ["CI", "GITHUB_ACTIONS"]
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
